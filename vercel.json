{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/_mintlify/:path*",
      "destination": "https://personal-d5cb568f.mintlify.site/_mintlify/:path*"
    },
    {
      "source": "/api/request",
      "destination": "https://personal-d5cb568f.mintlify.site/_mintlify/api/request"
    },
    {
      "source": "/docs",
      "destination": "https://personal-d5cb568f.mintlify.site/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://personal-d5cb568f.mintlify.site/docs/:match*"
    },
    {
      "source": "/mintlify-assets/:path+",
      "destination": "https://personal-d5cb568f.mintlify.site/mintlify-assets/:path+"
    }
  ],
  "headers": [
    {
      "source": "/((?!docs(?:/.*)?$|.*\\.(?:png|svg|jpg|jpeg|ico|css|js|woff2)$).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
